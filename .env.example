# HoodScan local configuration
PORT=5177
BLOCKSCOUT_ORIGIN=https://robinhoodchain.blockscout.com
DATABASE_URL=file:./data/hoodscan.sqlite

# Optional paid realtime provider values — keep real values in .env only.
QUICKNODE_RPC_URL=
QUICKNODE_WS_URL=
QUICKNODE_WEBHOOK_SECRET=

# Optional HoodID integration
HOODID_REGISTRY_ADDRESS=
HOODID_PROFILE_BASE_URL=https://www.hoodid.domains/

# Optional Telegram alerting
TELEGRAM_BOT_TOKEN=
FREE_ALERT_CHAT_ID=
PREMIUM_ALERT_CHAT_ID=
FREE_ALERT_DELAY_MINUTES=20
